# Variáveis de ambiente — PRODUÇÃO
# Copie este arquivo para `.env` NO SERVIDOR e ajuste os valores.

# ================================
# 1. AMBIENTE E PORTA
# ================================
NODE_ENV=production
PORT=3000
# Trust proxy: deixe TRUE quando estiver atrás de Nginx / Cloudflare / KingHost Proxy
TRUST_PROXY=1
# Timezone do banco e datas. Formato aceito: OFFSET numérico (+HH:MM / -HH:MM).
# Maranhão (e todo Brasil em 2026) é sempre -03:00 (sem horário de verão).
# Obs: você PODE usar "America/Fortaleza" que o app converte automaticamente
# para o offset, mas para 0 warnings no MySQL2 prefira o formato -HH:MM.
TIMEZONE=-03:00

# ================================
# 2. SESSÃO / COOKIES
# ================================
# Gere um segredo forte no shell com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=coloque-um-segredo-forte-de-pelo-menos-64-caracteres-hex
# HTTPS obrigatório em produção = true. Só use false se ainda não tiver SSL configurado.
SESSION_COOKIE_SECURE=true
# Quando secure=true (HTTPS) use 'none'. Quando secure=false (HTTP) use 'lax'.
SESSION_COOKIE_SAMESITE=none

# ================================
# 3. TÍTULO / RODAPÉ / CONTATO
# ================================
SITE_TITLE=Trilha dos Quilombos
SITE_DESCRIPTION=Trilha dos Quilombos — 27 de setembro em Mirinzal-MA. Aventura, natureza e esporte sobre duas rodas.
FOOTER_TAGLINE=Aventura, natureza e adrenalina em um único evento de ciclismo.
CONTACT_EMAIL=contato@trilhadosquilombos.com.br
CONTACT_PHONE=(98) 99999-9999
# Para múltiplos telefones, separar por vírgula:
# CONTACT_PHONES=(98) 99999-9999,(98) 98888-8888
WHATSAPP_TEXT=Olá! Tenho dúvidas sobre a Trilha dos Quilombos.

SOCIAL_FACEBOOK=#
SOCIAL_INSTAGRAM=https://instagram.com/trilhadosquilombos
SOCIAL_TWITTER=#

# Link CONVITE do GRUPO do WHATSAPP (grupo dos atletas / organização).
# Usado em: header (desktop/mobile), botão flutuante, tela de pagamento, rodapé.
# Você pode gerar um novo em "Configurações do Grupo → Convidar para o grupo via link".
# Observação: O pagamento CONFIRMADO NÃO redireciona mais automaticamente para o grupo,
# o usuário só entra se clicar em um dos botões "Entrar no grupo".
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/Dn3RghO98MS7x5Rvrkqkjp?s=sh&p=a&ilr=0

# ================================
# 4. BANCO DE DADOS MYSQL (KingHost VPS ou Managed)
# ================================
DB_NAME=trilha_quilombos
# Na KingHost, seu usuário MySQL costuma ser prefixo_nome (ex.: hosped_nomedb)
DB_USER=root
# SENHA FORTE - gere aleatória no painel KingHost
DB_PASSWORD=senhaForte
# Se o MySQL do mesmo VPS → localhost.
# Se KingHost MySQL gerenciado → host do painel (ex.: mysql01.kinghost.net)
DB_HOST=localhost
DB_PORT=3306
# Deixe FALSE se o banco for LOCAL (mesmo VPS). TRUE só para Managed DB SSL.
DB_SSL=false
# Packet size: mantenha false a menos que importe BLOB gigantes de foto manualmente
DB_TUNE_MAX_PACKET=false
DB_MAX_PACKET_BYTES=16777216

# ================================
# 5. MERCADO PAGO — PRODUÇÃO
# ================================
# Access TOKEN PRODUÇÃO (não use o de teste aqui!)
# Obtido em: https://www.mercadopago.com.br/developers/panel/credentials
MP_ACCESS_TOKEN=APP_USR-seu-access-token-aqui
# Webhook URL — DEVE ser HTTPS com domínio correto
# Para este projeto:
MP_NOTIFICATION_URL=trilhadoburiti.com.br/webhooks/mercadopago

# ================================
# 6. PREÇOS (EM REAIS, NÚMERO, SEM R$)
# ================================
PRICE_ATLETA=50
PRICE_ACOMPANHANTE=30

# ================================
# 7. ADMINISTRADOR
# ================================
# SÃO AS CREDENCIAIS DE ACESSO AO PAINEL. MUDE A SENHA!
ADMIN_EMAIL=admin@trilhadosquilombos.com.br
ADMIN_NAME=Administrador
# Senha forte (mínimo 8 caracteres)
ADMIN_PASSWORD=MudeSenhaAdminAqui!

# ================================
# 8. REGRAS DO EVENTO
# ================================
# Quantidade de atletas com direito a medalha
MEDAL_CUTOFF=300
# Limite TOTAL de atletas inscritos (normalmente igual a MEDAL_CUTOFF ou superior)
ATHLETE_LIMIT=300
# Limite de upload em MB (para fotos do avatar / galeria)
UPLOAD_MAX_MB=16

# ================================
# 9. DOMÍNIO PÚBLICO (opcional, usado em templates futuros)
# ================================
PUBLIC_SITE_URL=https://trilhadosquilombos.com.br
