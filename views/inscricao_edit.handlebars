<section class="section details">
  <div class="section__header section__header--with-action">
    <h2 class="section__title">Editar Inscrição #{{reg.id}}</h2>
    <span class="section__divider" aria-hidden="true"></span>
  </div>
  <div class="section__content" style="max-width:780px; margin:0 auto;">
    <div class="card">
      {{> flash}}
      <div class="card__meta" style="display:flex; flex-wrap:wrap; gap:12px; align-items:center; margin-bottom:16px;">
        <span class="status-badge" data-status="{{#if (eq reg.paymentStatus 'paid')}}paid{{else}}pending{{/if}}">{{#if (eq reg.paymentStatus 'paid')}}Pago{{else}}Pendente{{/if}}</span>
        <span class="type-badge" data-type="{{reg.type}}">{{#if (eq reg.type 'ATLETA')}}CICLISTA{{else}}ACOMPANHANTE{{/if}}</span>
        {{#if reg.paidOrder}}
          <span class="badge">Placa {{reg.paidOrder}}</span>
        {{/if}}
      </div>
      <form method="POST" action="/admin/inscricoes/{{reg.id}}/editar" class="form" novalidate>
        <div class="form__row" style="display:flex; gap:12px;">
          <div style="flex:2">
            <label>Nome do Ciclista (completo)</label>
            <input type="text" name="realName" value="{{reg.realName}}" class="input" placeholder="Nome completo do ciclista" />
          </div>
        </div>
        <div class="form__row" style="display:flex; gap:12px;">
          <div style="flex:2">
            <label>Nome para o avatar / cartão</label>
            <input type="text" name="name" value="{{reg.name}}" class="input" placeholder="Nome/apelido (aparece no cartão)" />
          </div>
          <div style="flex:1">
            <label>CPF</label>
            <input type="text" name="cpf" value="{{reg.cpf}}" class="input" placeholder="000.000.000-00" />
          </div>
        </div>
        <div class="form__row" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>Cidade</label>
            <input type="text" name="city" value="{{reg.city}}" class="input" placeholder="Cidade/UF" />
          </div>
          <div style="flex:1">
            <label>Grupo</label>
            <input type="text" name="group" value="{{reg.group}}" class="input" placeholder="Equipe/Grupo" />
          </div>
        </div>
        <div class="form__row" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>Data de Nascimento</label>
            <input id="editBirthDate" type="text" name="birthDate" value="{{formatDateBR reg.birthDate}}" class="input" placeholder="DD/MM/AAAA" inputmode="numeric" maxlength="10" />
            <small id="editBirthAge" style="color:#ffe7ad; opacity:.9;">Idade: —</small>
          </div>
          <div style="flex:1">
            <label>Telefone</label>
            <input type="text" name="phone" value="{{reg.phone}}" class="input" placeholder="DDD + número" />
          </div>
        </div>
        <div class="form__row" style="display:flex; gap:12px;">
          <div style="flex:1">
            <label>Tipo</label>
            <select name="type" class="input">
              <option value="ATLETA" {{#if flags.isATLETA}}selected{{/if}}>CICLISTA</option>
              <option value="ACOMPANHANTE" {{#if flags.isACOMPANHANTE}}selected{{/if}}>ACOMPANHANTE</option>
            </select>
          </div>
          <div style="flex:1">
            <label>Valor</label>
            <input type="number" step="0.01" name="amount" value="{{reg.amount}}" class="input" placeholder="0,00" />
          </div>
        </div>
        <div class="form__actions" style="display:flex; gap:12px; justify-content:flex-start;">
          <button type="submit" class="btn btn--primary">Salvar</button>
          <a href="/admin/inscricoes" class="btn">Voltar</a>
        </div>
      </form>
    </div>
  </div>
</section>
<script>
  (function () {
    const input = document.getElementById('editBirthDate');
    const ageEl = document.getElementById('editBirthAge');
    if (!input) return;
    function onlyDigits(str) { return String(str || '').replace(/\D/g, ''); }
    function formatDateBR(raw) {
      const digits = onlyDigits(raw).slice(0, 8);
      const parts = [];
      if (digits.length > 0) parts.push(digits.substring(0, 2));
      if (digits.length > 2) parts.push(digits.substring(2, 4));
      if (digits.length > 4) parts.push(digits.substring(4, 8));
      return parts.join('/');
    }
    function calcAge(y, m, d) {
      const t = new Date(), b = new Date(y, m - 1, d);
      let a = t.getFullYear() - b.getFullYear();
      const mo = t.getMonth() - b.getMonth();
      if (mo < 0 || (mo === 0 && t.getDate() < b.getDate())) a -= 1;
      return a;
    }
    function updateAge() {
      const digits = onlyDigits(input.value);
      if (digits.length !== 8) { if (ageEl) ageEl.textContent = 'Idade: —'; return; }
      const d = parseInt(digits.substring(0, 2), 10);
      const m = parseInt(digits.substring(2, 4), 10);
      const y = parseInt(digits.substring(4, 8), 10);
      const dm = new Date(y, m - 1, d);
      const invalid = dm.getFullYear() !== y || dm.getMonth() !== m - 1 || dm.getDate() !== d;
      const today = new Date(); today.setHours(0,0,0,0);
      if (invalid || dm.getTime() > today.getTime() || !ageEl) { ageEl.textContent = 'Idade: inválida'; return; }
      const age = calcAge(y, m, d);
      if (age < 5 || age > 122) { ageEl.textContent = 'Idade: inválida'; return; }
      ageEl.textContent = `Idade: ${age} ano${age === 1 ? '' : 's'}`;
    }
    input.addEventListener('input', () => { input.value = formatDateBR(input.value); try { input.setSelectionRange(input.value.length, input.value.length); } catch(_) {} updateAge(); });
    updateAge();
  })();
</script>