<section class="section about">
  <div class="section__header">
    <h2 class="section__title">Entrar como Administrador</h2>
    <span class="section__divider" aria-hidden="true"></span>
  </div>

  <div class="about__card" style="max-width:520px; margin:0 auto;">
    <div class="section__content">
      {{> flash}}
      <form method="POST" action="/admin/login">
        <div style="margin-bottom:12px;">
          <label for="email">E-mail</label>
          <input type="email" id="email" name="email" required style="width:100%; padding:10px; border-radius:10px; border:1px solid rgba(255,255,255,0.35); background: transparent; color:#fff;" />
        </div>
        <div style="margin-bottom:12px;">
          <label for="password">Senha</label>
          <input type="password" id="password" name="password" required style="width:100%; padding:10px; border-radius:10px; border:1px solid rgba(255,255,255,0.35); background: transparent; color:#fff;" />
        </div>
        <button type="submit" class="btn btn--primary" style="width:100%;">Entrar</button>
      </form>
    </div>
  </div>
</section>