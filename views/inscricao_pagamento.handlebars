<section class="section" id="pagamento" data-reg-id="{{reg.id}}">
  <div class="section__content">
    <div class="card">
      <h2 class="card__title">Pagamento PIX</h2>
      {{> flash}}
      {{#if reg}}
        <p class="lead">
          Olá, <strong>{{greetingName}}</strong>!
          {{#if showCardNameSub}}
            <br><small style="font-size:.9rem; opacity:.8;">(no cartão: <strong>{{cardNameSub}}</strong>)</small>
          {{/if}}
        </p>
        <div class="payment-summary">
          <span>Inscrição: {{#if reg.type}}{{reg.type}}{{else}}não informado{{/if}}</span>
          <span>Valor: <strong>R$ {{displayAmount}}</strong></span>
        </div>

        {{#if reg.mpQrCodeBase64}}
          <div class="pix">
            <div class="pix__qr-wrap">
              <img src="data:image/png;base64,{{reg.mpQrCodeBase64}}" alt="QR Code PIX para {{reg.name}}" class="pix__qr" />
            </div>
            <p class="pix__caption">Escaneie o QR code no seu banco para pagar.</p>
          </div>
        {{else}}
          <div class="alert">QR Code indisponível. Verifique configuração do Mercado Pago.</div>
        {{/if}}

        {{#if reg.mpQrCode}}
          <div class="pix__codegroup">
            <label for="pix-code">PIX Copia e Cola</label>
            <div class="pix__row">
              <input id="pix-code" type="text" readonly value="{{reg.mpQrCode}}" />
              <button type="button" class="btn" id="copy-pix">Copiar</button>
            </div>
            <small class="pix__hint">Se preferir, copie e cole este código no app do seu banco.</small>
        </div>
        {{/if}}

        {{#if reg.mpTicketUrl}}
          <p><a href="{{reg.mpTicketUrl}}" target="_blank" rel="noopener" class="btn">Abrir boleto/QR</a></p>
        {{/if}}

        <div class="status">
          <div class="status__spinner" aria-hidden="true"></div>
          <span>Aguardando confirmação do pagamento...</span>
        </div>


        <div class="form__actions" style="justify-content: flex-start; gap: 1rem;">
          <a class="btn" href="/inscricao">Voltar</a>
        </div>
      {{/if}}
      
      <div id="payment-confirm-modal" class="modal modal--success hidden" aria-hidden="true" role="dialog" aria-labelledby="payment-confirm-title">
        <div class="modal__dialog" role="document">
          <div class="modal__header">
            <h3 id="payment-confirm-title" class="modal__title">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="icon" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
              <span>Pagamento confirmado</span>
            </h3>
            <button class="modal__close" type="button" aria-label="Fechar" data-modal-close>&times;</button>
          </div>
          <div class="modal__content">
            <p class="modal__text">Seu pagamento foi aprovado. Deseja baixar seu card personalizado agora?</p>
          </div>
          <div class="modal__actions">
            <button type="button" class="btn btn--primary" id="modal-confirm-yes">Sim, baixar agora</button>
            <button type="button" class="btn btn--secondary" id="modal-confirm-no">Depois</button>
          </div>
        </div>
      </div>
  </div>
</div>
</section>
<div class="section-divider" aria-hidden="true"></div>
