<section class="section details">
  <div class="section__header">
    <h2 class="section__title">Dashboard Designer</h2>
    <span class="section__divider" aria-hidden="true"></span>
  </div>
  <div class="admin-cards" style="max-width:1000px; margin: 0 auto;">
    <div class="admin-card">
      <div class="admin-card__title">
        <span class="admin-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
          </svg>
        </span>
        <span>Meu Perfil</span>
      </div>
      <p class="admin-card__desc">Atualize seu nome de exibição e altere sua senha.</p>
      <div class="admin-card__actions">
        <a href="/admin/perfil" class="btn btn--primary">Abrir Perfil</a>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card__title">
        <span class="admin-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="14" rx="2" ry="2"/>
            <circle cx="8" cy="10" r="2"/>
            <path d="M21 19l-5-5-4 4-2-2-5 5"/>
          </svg>
        </span>
        <span>Gerenciar Galeria</span>
      </div>
      <p class="admin-card__desc">Faça upload de imagens e vídeos e exclua itens da galeria.</p>
      <div class="admin-card__actions">
        <a href="/admin/galeria" class="btn btn--primary">Abrir Galeria</a>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card__title">
        <span class="admin-card__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2" ry="2"/>
            <path d="M7 8h10"/>
            <path d="M7 12h10"/>
            <path d="M7 16h10"/>
          </svg>
        </span>
        <span>Baixar Cards</span>
      </div>
      <p class="admin-card__desc">Baixe um ZIP com todos os cards do intervalo, usando a mesma fonte do preview.</p>
      <div class="admin-card__actions">
        <a href="/design" class="btn btn--primary">Abrir Download</a>
      </div>
    </div>
  </div>
</section>
