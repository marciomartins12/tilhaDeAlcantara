<header class="navbar">
  <div class="navbar__left">
    <a href="/" class="logo" aria-label="Ir para início">
      <img src="/public/img/logo.png" alt="logo" class="logo__icon">

      
    </a>
  </div>
  <nav class="navbar__nav" aria-label="Navegação principal">
    <ul class="nav__list">
      <li><a href="/#inicio" class="nav__link {{#if (eq activeNav 'home')}}is-active{{/if}}">Início</a></li>
      <li><a href="/galeria" class="nav__link {{#if (eq activeNav 'galeria')}}is-active{{/if}}">Galeria</a></li>

      <li><a href="/inscricao" class="nav__link {{#if (eq activeNav 'inscricao')}}is-active{{/if}}">Inscrição</a></li>
      <li><a href="/#baixar-card" class="nav__link">Baixar Avatar</a></li>
      <li><a href="/#pagamento-pendente" class="nav__link">Fazer Pagamento</a></li>
      <li>
        <a href="{{whatsappGroupUrl}}" target="_blank" rel="noopener"
          class="nav__link nav__link--whatsapp" aria-label="Entrar no grupo do WhatsApp">
