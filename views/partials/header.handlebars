          </svg>
          <span>Grupo WhatsApp</span>
        </a>
      </li>
      {{#if admin}}
      {{#if (eq admin.role 'DESIGN')}}
      {{#unless (eq currentPath '/design/dashboard')}}
      <li><a href="/design/dashboard" class="nav__link nav__link--dashboard">Ir para Dashboard</a></li>
      {{/unless}}
      {{else}}
      {{#unless (eq currentPath '/admin/dashboard')}}
      <li><a href="/admin/dashboard" class="nav__link nav__link--dashboard">Ir para Dashboard</a></li>
      {{/unless}}
      {{/if}}
      {{/if}}
      <li>
        {{#if admin}}
        <form method="POST" action="/admin/logout">
          <button type="submit" class="nav__link nav__link--logout">Sair</button>
        </form>
        {{else}}
        <a href="/admin" class="nav__link {{#if (eq activeNav 'admin')}}is-active{{/if}}">Entrar como Administrador</a>
        {{/if}}
      </li>
    </ul>
