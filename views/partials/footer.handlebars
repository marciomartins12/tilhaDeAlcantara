<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__brand">
  <div class="footer__logo">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="footer__logo-icon" aria-hidden="true">
          <path d="M6.5 12c.94-3.46 4.94-6 8.5-6 3.56 0 6.06 2.54 7 6-.94 3.47-3.44 6-7 6s-7.56-2.53-8.5-6Z"></path>
          <path d="M18 12v.5"></path>
          <path d="M16 17.93a9.77 9.77 0 0 1 0-11.86"></path>
          <path d="M7 10.67C7 8 5.58 5.97 2.73 5.5c-1 1.5-1 5 .23 6.5-1.24 1.5-1.24 5-.23 6.5C5.58 18.03 7 16 7 13.33"></path>
          <path d="M10.46 7.26C10.2 5.88 9.17 4.24 8 3h5.8a2 2 0 0 1 1.98 1.67l.23 1.4"></path>
          <path d="m16.01 17.93-.23 1.4A2 2 0 0 1 13.8 21H9.5a5.96 5.96 0 0 0 1.49-3.98"></path>
        </svg>
        <div class="footer__logo-text">
          <span class="footer__logo-title">Trilha do</span>
          <span class="footer__logo-brand">Buriti</span>
        </div>
      </div>
      <p class="footer__tagline">{{footer.tagline}}</p>
    </div>

    <div class="footer__contact">
      <h4 class="footer__heading">Contato</h4>
      <ul class="footer__list" aria-label="Informações de contato">
        <li class="footer__item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="footer__icon" aria-hidden="true">
            <path d="M4 4h16v16H4z"></path>
            <path d="M22 6l-10 7L2 6"></path>
          </svg>
          <a href="mailto:{{footer.contactEmail}}" class="footer__link">{{footer.contactEmail}}</a>
        </li>
        {{#each footer.contactPhonesMeta}}
        <li class="footer__item">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="footer__icon" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.031-.964-.273-.099-.472-.148-.671.149-.198.297-.769.964-.943 1.162-.173.199-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.474-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.173.198-.298.297-.496.099-.199.05-.372-.025-.521-.074-.149-.671-1.618-.92-2.219-.242-.582-.487-.503-.671-.511-.173-.008-.372-.01-.571-.01-.198 0-.521.074-.794.372-.273.297-1.04 1.016-1.04 2.479 0 1.463 1.065 2.879 1.213 3.078.149.198 2.099 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.718 2.006-1.412.248-.694.248-1.289.173-1.412-.074-.123-.272-.198-.57-.347z"/>
            <path d="M12.004 2.003c-5.514 0-10 4.486-10 10 0 1.768.469 3.424 1.284 4.858L2 22l5.253-1.378c1.387.751 2.966 1.18 4.751 1.18 5.514 0 10-4.486 10-10s-4.486-10-10-10zm0 18.197c-1.579 0-3.052-.43-4.318-1.175l-.309-.184-3.115.817.832-3.039-.201-.312c-.774-1.235-1.223-2.691-1.223-4.204 0-4.422 3.596-8.018 8.018-8.018 4.422 0 8.018 3.596 8.018 8.018 0 4.422-3.596 8.018-8.018 8.018z"/>
          </svg>
          <a href="https://wa.me/{{this.wa}}?text={{../footer.whatsappTextEncoded}}" target="_blank" rel="noopener" class="footer__link">{{this.display}}</a>
        </li>
        {{/each}}
      </ul>
    </div>

    <div class="footer__social">
      <h4 class="footer__heading">Redes Sociais</h4>
      <div class="social">
        
        <a href="{{footer.socialInstagram}}" class="social__btn" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <path d="M17.5 6.5h.01"/>
          </svg>
        </a>
        
      </div>
    </div>
  </div>

  <div class="footer__divider" aria-hidden="true"></div>
  <div class="footer__bottom">© {{year}} {{footer.brandTitle}}. Desenvolvido por @marciomartins_12.</div>
</footer>