        </div>
      </form>
    </div>
  </div>
</section>
<div class="section-divider" aria-hidden="true"></div>
<section id="pagamento-pendente" class="section cta">
  <div class="cta__content">
    <h2 class="cta__title">Já se inscreveu e não pagou?</h2>
    <p class="cta__text">Informe seu CPF para acessar seu QR Code PIX e finalizar.</p>
    <div class="cta__actions">
      <form id="cpf-pay-form" class="cpf-form" novalidate>
        <p id="cpf-pay-error" class="alert alert--error hidden" aria-live="polite"></p>
        <label for="cpf-pay-input" class="sr-only">CPF</label>
        <div class="cpf-form__row">
          <input type="text" id="cpf-pay-input" name="cpf" class="cpf-input" placeholder="000.000.000-00"
            inputmode="numeric" autocomplete="off" maxlength="14" aria-describedby="cpf-pay-error" />
          <button type="submit" class="btn btn--primary btn--cta">Continuar Pagamento <span
              class="arrow">→</span></button>
        </div>
      </form>
    </div>
  </div>
</section>
<script>
  (function () {
    const form = document.getElementById('cpf-inline-form');
    const input = document.getElementById('cpf-inline-input');
    const errorEl = document.getElementById('cpf-inline-error');

    function onlyDigits(str) { return String(str || '').replace(/\D/g, ''); }
    function formatCpf(digits) {
      const d = onlyDigits(digits).slice(0, 11);
      const parts = [];
      if (d.length > 0) parts.push(d.substring(0, 3));
      if (d.length > 3) parts.push(d.substring(3, 6));
      if (d.length > 6) parts.push(d.substring(6, 9));
      const base = parts.join('.');
      if (d.length > 9) return `${base}-${d.substring(9, 11)}`;
      return base;
    }
    function isValidCPF(raw) {
      const cpf = onlyDigits(raw);
      if (!cpf || cpf.length !== 11) return false;
      if (/^(\d)\1{10}$/.test(cpf)) return false;
      let sum = 0;
      for (let i = 0; i < 9; i++) sum += parseInt(cpf.charAt(i), 10) * (10 - i);
      let first = (sum * 10) % 11; if (first === 10) first = 0;
      if (first !== parseInt(cpf.charAt(9), 10)) return false;
      sum = 0;
      for (let i = 0; i < 10; i++) sum += parseInt(cpf.charAt(i), 10) * (11 - i);
      let second = (sum * 10) % 11; if (second === 10) second = 0;
      if (second !== parseInt(cpf.charAt(10), 10)) return false;
      return true;
    }

    input?.addEventListener('input', () => {
      const digits = onlyDigits(input.value);
      input.value = formatCpf(digits);
      // manter o cursor no final para evitar saltos indesejados
      try { input.setSelectionRange(input.value.length, input.value.length); } catch (_) { }
      if (!errorEl.classList.contains('hidden')) errorEl.classList.add('hidden');
    });
    input?.addEventListener('paste', (e) => {
      const cd = e.clipboardData || window.clipboardData;
      // Se temos acesso ao clipboard, tratamos manualmente; caso contrário, deixamos o comportamento padrão
      if (cd && typeof cd.getData === 'function') {
        e.preventDefault();
        const txt = cd.getData('text');
        const digits = onlyDigits(txt).slice(0, 11);
        input.value = formatCpf(digits);
        try { input.setSelectionRange(input.value.length, input.value.length); } catch (_) { }
      }
    });
    // Removido o bloqueio de teclas para maximizar compatibilidade de colagem

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = input?.value || '';
      const cpfDigits = onlyDigits(raw);
      if (!isValidCPF(cpfDigits)) {
        errorEl.textContent = 'CPF inválido.';
        errorEl.classList.remove('hidden');
        input?.focus?.();
        return;
      }
      try {
        const resp = await fetch('/inscricao/consulta-cpf', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cpf: cpfDigits })
        });
        const data = await resp.json();
        if (!resp.ok) {
          window.showPopup('Erro na consulta de CPF', data?.error || 'Falha na consulta de CPF', 'error');
          return;
        }
        if (!data?.found) {
          window.showToast('Você ainda não está inscrito. Indo para a inscrição…', 'info');
          window.location.href = '/inscricao';
          return;
        }
        if (data.paymentStatus === 'pending') {
          window.location.href = `/inscricao/pagamento/${data.id}`;
        } else {
          window.location.href = `/inscricao/card/${data.id}`;
        }
      } catch (e) {
        window.showPopup('Erro ao consultar CPF', 'Tente novamente em alguns instantes.', 'error');
      }
    });
  })();
</script>


