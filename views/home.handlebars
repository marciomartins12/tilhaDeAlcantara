<section id="baixar-card" class="section cta">
  <div class="cta__bg-icons" aria-hidden="true"></div>

  <div class="cta__content">



    <h2 class="cta__title">Card de Identificação (avatar)</h2>

    <div class="cta__preview" aria-label="Prévia do card de identificação (avatar)">
