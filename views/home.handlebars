<script>
  (function () {
    const list = document.getElementById('perksList');
    const actions = document.getElementById('perksActions');
    if (!list || !actions) return;

    const expandBtn = actions.querySelector('[data-perks-action="expand"]');
    const collapseBtn = actions.querySelector('[data-perks-action="collapse"]');
    const countEl = document.getElementById('perksCount');
    const totalItems = list.querySelectorAll('li').length;
    if (countEl && totalItems) {
      countEl.textContent = `+${totalItems} itens exclusivos`;
    }

    function isMobile() {
      return window.matchMedia('(max-width: 767px)').matches;
    }

    function setCollapsed() {
      list.classList.add('is-collapsed');
      list.classList.remove('is-expanded');
      expandBtn?.removeAttribute('aria-hidden');
      collapseBtn?.setAttribute('aria-hidden', 'true');
    }

    function setExpanded() {
      list.classList.remove('is-collapsed');
      list.classList.add('is-expanded');
      expandBtn?.setAttribute('aria-hidden', 'true');
      collapseBtn?.removeAttribute('aria-hidden');
    }

    function syncStateOnResize() {
      if (isMobile()) {
        if (!list.classList.contains('is-expanded')) setCollapsed();
        actions.style.display = '';
      } else {
        list.classList.remove('is-collapsed');
        list.classList.add('is-expanded');
        actions.style.display = 'none';
      }
    }

    expandBtn?.addEventListener('click', function () {
      if (!isMobile()) return;
      setExpanded();
      const items = list.querySelectorAll('li');
      if (items[4]) items[4].focus?.();
    });
    collapseBtn?.addEventListener('click', function () {
      if (!isMobile()) return;
      setCollapsed();
      expandBtn.focus?.();
    });

    window.addEventListener('resize', syncStateOnResize);
    syncStateOnResize();
  })();
</script>
<script>
  (function () {
    const preview = document.getElementById('mapVideoPreview');
    if (!preview) return;
    const playBtn = preview.querySelector('.video-preview__play');
    playBtn?.addEventListener('click', function () {
      const video = document.createElement('video');
      video.className = 'details__map-image';
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.preload = 'none';
      const source = document.createElement('source');
      source.src = '/public/img/videoRota.mp4';
      source.type = 'video/mp4';
      video.appendChild(source);
      preview.replaceWith(video);
      video.play?.().catch(() => { });
    });
  })();
</script>
