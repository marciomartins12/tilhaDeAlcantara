<section class="section" id="galeria">
  <div class="section__header">
    <h2 class="section__title">Galeria</h2>
    <span class="section__divider" aria-hidden="true"></span>
  </div>
  <div class="section__content">
    {{#if items.length}}
      <div class="gallery-grid">
        {{#each items}}
          <div class="gallery-item">
            <div class="gallery-item__media">
              {{#if (isImage this.type this.filePath this.mimeType this.originalName)}}
                <img src="{{mediaUrl this.filePath this.id}}" alt="{{this.title}}" class="gallery-item__thumb" data-modal-target="#modal-image-view" />
              {{else}}
                {{#if (isVideo this.type this.filePath this.mimeType this.originalName)}}
                  <video src="{{mediaUrl this.filePath this.id}}" class="gallery-item__thumb" controls preload="metadata"></video>
                {{else}}
                  <p>Tipo de mídia não reconhecido.</p>
                {{/if}}
              {{/if}}
            </div>
            {{#if this.title}}
              <div class="gallery-item__meta">
                <strong>{{this.title}}</strong>
                {{#if this.description}}<p class="gallery-item__desc">{{this.description}}</p>{{/if}}
              </div>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="empty-state">
        <div class="empty-state__icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="2"/>
            <path d="M21 15l-4-4-7 7"/>
          </svg>
        </div>
        <h3 class="empty-state__title">Ainda sem publicações</h3>
        <p class="empty-state__desc">Em breve teremos fotos e vídeos da Trilha do Buriti.</p>
        <div class="empty-state__actions">
          <a href="/" class="btn btn--primary">Voltar ao Início <span class="arrow">→</span></a>
        </div>
      </div>
    {{/if}}
  </div>
</section>